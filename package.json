{
  "name": "bare-pointer",
  "version": "0.1.6",
  "description": "Simulated pointer input for testing Bare apps",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "imports": {
    "#backend": {
      "darwin": "./lib/darwin.js",
      "ios": "./lib/ios.js",
      "linux": "./lib/linux.js",
      "android": "./lib/android.js",
      "win32": "./lib/win32.js",
      "default": "./lib/unsupported.js"
    },
    "#fixture": {
      "darwin": "./test/fixtures/darwin.js",
      "ios": "./test/fixtures/ios.js",
      "linux": "./test/fixtures/linux.js",
      "android": "./test/fixtures/android.js",
      "win32": "./test/fixtures/win32.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib"
  ],
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "bare-native-test --runtime ./test/runtime.js test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-pointer.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-pointer/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-pointer#readme",
  "dependencies": {
    "bare-animation-frame": "^0.1.1",
    "bare-app-kit": "^0.3.4",
    "bare-foundation": "^0.1.1",
    "bare-ndk": "^0.3.4",
    "bare-ui-kit-touch": "^0.1.0",
    "bare-user32": "^0.1.1",
    "bare-win-ui": "^0.3.7",
    "bare-x11": "^0.1.0",
    "bare-x11-xtest": "^0.1.0"
  },
  "devDependencies": {
    "bare-gtk": "^0.4.2",
    "bare-native-test": "^0.1.3",
    "bare-tap": "^1.1.0",
    "bare-ui-kit": "^0.3.1",
    "lunte": "^1.8.0",
    "prettier": "^3.4.2",
    "prettier-config-holepunch": "^2.0.0"
  }
}
